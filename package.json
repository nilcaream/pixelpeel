{
  "name": "pixelpeel",
  "version": "1.2.1",
  "private": true,
  "description": "A puzzle in the browser: little dots peel a pixel picture apart, colour by colour, and you choose the order",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bake": "node scripts/bake.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
