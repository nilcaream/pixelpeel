{
  "name": "pixelpeel",
  "version": "1.4.1",
  "private": true,
  "description": "A puzzle in the browser: little dots peel a pixel picture apart, colour by colour, and you choose the order",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bake": "node scripts/bake.ts",
    "design:deals": "node scripts/design/deals.ts",
    "design:reach": "node scripts/design/reach.ts",
    "design:order": "node scripts/design/order.ts",
    "design:preview": "node scripts/design/preview.ts",
    "design:gallery": "node scripts/design/gallery.ts",
    "design:rows": "node scripts/design/rows-check.ts",
    "design:palette": "node scripts/design/palette.ts",
    "design:pressure": "node scripts/design/pressure.ts",
    "design:tree": "node --max-old-space-size=16000 scripts/design/tree.ts",
    "design:rating": "node --max-old-space-size=8000 scripts/design/rating.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
